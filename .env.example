# Environment variables for PostgreSQL Tuning Tools - Group 16
# Copy this file to .env and replace the placeholder password before starting Docker.

POSTGRES_DB=tuning_lab
POSTGRES_USER=projectuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# pgbench configuration (as specified in project proposal)
PGBENCH_SCALE=50
PGBENCH_CLIENTS=10
PGBENCH_THREADS=2
PGBENCH_DURATION_SECONDS=60
BENCHMARK_RUNS=3
